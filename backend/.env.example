DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB — paste your real connection string here (do not commit .env)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_DB_NAME=gomechanic_tech_support

# JWT
JWT_SECRET=change-this-to-a-random-secret
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# Karix WhatsApp (CPaaS) — fill in once credentials/template IDs are shared
KARIX_API_BASE_URL=https://api.karix.io
KARIX_API_KEY=
KARIX_SOURCE_ADDRESS=

# Media (uploaded ticket attachments)
MEDIA_URL=/media/
MEDIA_ROOT=media
